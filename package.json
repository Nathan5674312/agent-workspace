{
  "name": "agent-workspace",
  "version": "1.0.5",
  "description": "Full-screen vault workspace with a floating agent corner.",
  "author": "Divine Construct",
  "homepage": "https://github.com/Nathan5674312/agent-workspace",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/",
    "dist": "npm run build && electron-builder",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "lucide-react": "^1.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-force": "^3.0.0",
    "electron": "^33.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.divineconstruc.fate",
    "productName": "Fate",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "out/**",
      "package.json",
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "extraResources": [
      {
        "from": "build/themed",
        "to": "icons",
        "filter": [
          "*.png"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "executableName": "FateVault"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
